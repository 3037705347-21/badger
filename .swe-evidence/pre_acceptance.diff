+	e := &Entry{
+		Key:   rangeDelKey(startKey),
+		Value: endKey,
+		meta:  bitRangeDelete,
+	}
+	if err := txn.modifyEntry(e, true); err != nil {
+		return err
+	}
+	txn.pendingRangeDels = append(txn.pendingRangeDels, pendingRangeDel{
+		start: startKey,
+		end:   endKey,
+		seq:   e.opSeq,
+	})
+	return nil
